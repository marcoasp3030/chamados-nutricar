# ===== Variáveis de produção (NÃO COMMITAR) =====
# Copie para .env.production na VPS e preencha.

# Banco
POSTGRES_PASSWORD=troque-esta-senha-forte
DATABASE_URL=postgres://app:troque-esta-senha-forte@db:5432/app

# Auth
JWT_SECRET=gere-com-openssl-rand-base64-48
SESSION_COOKIE_NAME=chamados_session
SESSION_TTL_DIAS=365

# Storage local
STORAGE_DIR=/data/storage
STORAGE_URL_SECRET=gere-com-openssl-rand-base64-48
APP_BASE_URL=https://chamados.seu-dominio.com

# Domínio (Caddy)
DOMAIN=chamados.seu-dominio.com

# IA / integrações
OPENAI_API_KEY=
VMPAY_API_KEY=

# Supabase — obrigatório para o app; VITE_* entram no JS do browser no `docker compose build`
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=chave_anon_publica
VITE_SUPABASE_PROJECT_ID=id_do_projeto
