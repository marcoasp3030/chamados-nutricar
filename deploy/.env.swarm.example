# ===== Variáveis do deploy em Swarm/Traefik (NÃO COMMITAR a versão real) =====
#
# Crie `deploy/.env.swarm` a partir deste arquivo.
# Deploy: bash deploy/deploy-swarm.sh

DOMAIN=nutricarhub.nutricarbrasil.com.br
APP_BASE_URL=https://nutricarhub.nutricarbrasil.com.br

# Postgres Swarm (serviço/alias: postgres)
DATABASE_URL=postgres://postgres:SUA_SENHA_AQUI@postgres:5432/chamados

# PostgREST (role authenticator — mesma senha do POSTGRES ou dedicada)
POSTGREST_AUTH_PASSWORD=SUA_SENHA_AQUI
POSTGREST_DB_URI=postgres://authenticator:SUA_SENHA_AQUI@postgres:5432/chamados

# Auth / sessão
JWT_SECRET=gere-com-openssl-rand-base64-48
SESSION_COOKIE_NAME=chamados_session
SESSION_TTL_DIAS=365
STORAGE_URL_SECRET=gere-com-openssl-rand-base64-48

# Integrações (opcional)
OPENAI_API_KEY=
VMPAY_API_KEY=

# Só para migrar dados do Supabase Cloud (exportar-dados-supabase.ts)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_do_painel_supabase
